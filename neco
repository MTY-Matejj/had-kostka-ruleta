#include <Wire.h>
#include <LiquidTWI2.h>

LiquidTWI2 lcd(0x20);

const int button9 = 9;
const int button8 = 8;

int buttonState9 = LOW;
int buttonState8 = LOW;
int lastButtonState9 = LOW;
int lastButtonState8 = LOW;
int stavy = 0;

uint8_t fullscreen[8] = {
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
};

void setup() {
  pinMode(button9, INPUT);
  pinMode(button8, INPUT);

  lcd.begin(16, 2);
  lcd.createChar(0, fullscreen);   // register the block character
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("VYPNUTO");
}

// Just displays the currently selected case name
void showMenu() {
  lcd.clear();
  lcd.setCursor(0, 0);
  switch (stavy) {
    case 0: lcd.print("VYPNUTO"); break;
    case 1: lcd.print("HAD:");    break;
    case 2: lcd.print("KOSTKA:"); break;
    case 3: lcd.print("RULETA:"); break;
  }
}

void loop() {
  buttonState9 = digitalRead(button9);
  buttonState8 = digitalRead(button8);

  // ---- Button 9: only switch between cases ----
  if (buttonState9 == HIGH && lastButtonState9 == LOW) {
    stavy++;
    if (stavy > 3) stavy = 0;

    showMenu();       // show which case is now selected
    delay(50);
  }

  // ---- Button 8: start the function of the selected case ----
  if (buttonState8 == HIGH && lastButtonState8 == LOW) {
    switch (stavy) {
      case 1:
        had();        // start snake
        break;
      case 2:
        // kostka();  // to be implemented
        break;
      case 3:
        // ruleta();  // to be implemented
        break;
      default:
        break;        // VYPNUTO - do nothing
    }
    showMenu();       // restore the menu label after the game ends
    delay(50);
  }

  lastButtonState9 = buttonState9;
  lastButtonState8 = buttonState8;
}

// ---------------- Snake ----------------
void had() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("HAD");

  // moving block on the top row
  for (int i = 5; i < 16; i++) {
    lcd.setCursor(i, 0);
    lcd.write((uint8_t)0);
    delay(250);
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("HAD");
  }

  // moving block on the bottom row
  for (int i = 15; i >= 4; i--) {
    lcd.setCursor(i, 1);
    lcd.write((uint8_t)0);
    delay(250);
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("HAD");
  }

  lcd.setCursor(5, 0);
}
