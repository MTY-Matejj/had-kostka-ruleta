#include <Wire.h>
#include <LiquidTWI2.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

LiquidTWI2 lcd(0x20);



const int button9 = 9;
const int button8 = 8;

int buttonState9 = LOW;
int buttonState8 = LOW;
int lastButtonState9 = LOW;
int lastButtonState8 = LOW;
int stavy = 0;

uint8_t fullscreen[8] = {
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
};

void setup() {
  Serial.begin(9600);


  pinMode(button9, INPUT);
  pinMode(button8, INPUT);

  lcd.begin(16, 2);
  lcd.createChar(0, fullscreen);   
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("VYPNUTO");
}

void showMenu() {
  lcd.clear();
  lcd.setCursor(0, 0);
  switch (stavy) {
    case 0: lcd.print("VYPNUTO"); break;
    case 1: lcd.print("HAD:");    break;
    case 2: lcd.print("KOSTKA:"); break;
    case 3: lcd.print("RULETA:"); break;
  }
}

void loop() {
  buttonState9 = digitalRead(button9);
  buttonState8 = digitalRead(button8);

  if (buttonState9 == HIGH && lastButtonState9 == LOW) {
    stavy++;
    if (stavy > 3) stavy = 0;
    showMenu();      
    delay(150);
  }

  if (buttonState8 == HIGH && lastButtonState8 == LOW) {
    switch (stavy) {
      case 1:
        had();        
        break;
      case 2:
        kostka();
        break;
      case 3:
        ruleta();
        break;
      default:
        break;        
    }
    showMenu();       
    delay(50);
  }

  lastButtonState9 = buttonState9;
  lastButtonState8 = buttonState8;
}



void had() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("HAD");

  for (int i = 5; i < 16; i++) {
    lcd.setCursor(i, 0);
    lcd.write((uint8_t)0);
    delay(250);
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("HAD");
  }

  for (int i = 15; i >= 4; i--) {
    lcd.setCursor(i, 1);
    lcd.write((uint8_t)0);
    delay(250);
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("HAD");
  }

  lcd.setCursor(5, 0);
}

void ruleta() {
    int kostkaHodnota = random(1, 40);
    lcd.print(kostkaHodnota);
    delay(100);
  
}

void kostka() {
  int kostkaHodnota = random(1, 6);
  lcd.print(kostkaHodnota);
  delay(200);
}


