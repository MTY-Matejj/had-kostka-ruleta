#include <LiquidTWI2.h>

LiquidTWI2 lcd(0x20);

uint8_t fullpixel [8] = {
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111,
  0b11111
};

int mode_btn = 9;
int act_btn = 8;
int mode_btn_state = 0;
int last_btn_state = LOW;
int mode = 0;
int act = 0;
bool updateDisplay = true;

void setup() {
  Serial.begin(9600);
  lcd.setMCPType(LTI_TYPE_MCP23008); 
  lcd.begin(16, 2);
  lcd.clear();
  lcd.createChar(0, fullpixel);
  
  pinMode(mode_btn, INPUT);
  pinMode(act_btn, INPUT);
}

void menu() {
  lcd.clear();
  lcd.setCursor(0, 0);
  switch (mode) {
    case 0: lcd.print("[0] HAD");    break;
    case 1: lcd.print("[1] KOSTKA"); break;
    case 2: lcd.print("[2] RULETA"); break;
  }
}

void loop() {
mode_btn_state = digitalRead(mode_btn);
act = digitalRead(act_btn);

debug(); 

  if (mode_btn_state == HIGH && last_btn_state == LOW) {
    mode = (mode + 1) % 3; // 0 -> 1 -> 2 -> 0
    lcd.clear();
    menu();
    delay(100);
  }
  last_btn_state = mode_btn_state;
  
  if (act == LOW) {
    lcd.clear();
    switch (mode) {
      case 0:
        had();
        break;
      case 1:
        kostka();
        break;
      case 2:
        ruleta();
        break;
    }
    updateDisplay = false;
  }
}

void had(){
lcd.clear();
lcd.print("[0] HAD");
lcd.setCursor(0, 0);
for (int i = 8; i <= 16; i++){
  lcd.setCursor(i, 0);
  lcd.write((uint8_t)0);
  delay(200);
  lcd.clear();
  lcd.print("[0] HAD");
}

lcd.setCursor(15, 1);
lcd.write((uint8_t)0);
delay(500);
lcd.clear();
lcd.print("[0] HAD");

for (int i = 15; i >= 8; i--) {
  lcd.setCursor(i, 1);
  lcd.write((uint8_t)0);
  delay(200);
  lcd.clear();
  lcd.print("[0] HAD");
  }

lcd.setCursor(8, 0);
lcd.write((uint8_t)0);
delay(500);
lcd.clear();
lcd.print("[0] HAD");
menu();
}

void kostka() {
lcd.clear();
int promena_k = random(1, 7);
lcd.clear();
lcd.setCursor(0, 0);
lcd.print("Cislo Kostka: ");
lcd.print(promena_k);
}

void ruleta() {
lcd.clear();
int promena_r = random(1, 40);
lcd.clear();
lcd.setCursor(0, 0);
lcd.print("Cislo Ruleta: ");
lcd.print(promena_r);
}

void debug(){
  Serial.print("ACT STATE: ");
  Serial.print(act);
  Serial.println("MODE: ");
  Serial.print(mode);
}
